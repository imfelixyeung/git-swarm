{
    "name": "@imfelixyeung/git-swarm",
    "description": "Manage multiple Git repositories with ease.",
    "version": "0.1.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/imfelixyeung/git-swarm"
    },
    "module": "src/cli.ts",
    "bin": {
        "git-swarm": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "private": false,
    "scripts": {
        "build": "bun build ./src/cli.ts --target=bun --outfile=dist/cli.js",
        "dev": "bun run build --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit",
        "biome": "biome check",
        "ci": "biome ci",
        "test": "bun test",
        "config-json-schema:update": "bun run src/scripts/make-config-json-schema.ts > src/config/schema.json",
        "changeset": "changeset",
        "changeset:version": "changeset version && biome check --write",
        "release": "bun run build && changeset publish"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.2",
        "@types/bun": "latest"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "cli-table3": "^0.6.5",
        "commander": "^15.0.0",
        "dedent": "^1.7.2",
        "p-limit": "^7.3.2",
        "picocolors": "^1.1.1",
        "simple-git": "^3.36.0",
        "tinyglobby": "^0.2.17",
        "zod": "^4.5.4"
    }
}
